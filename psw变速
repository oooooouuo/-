#define M4_B_PIN       GPIO_PIN_1
#define M4_B_PORT      GPIOB

// 电机控制宏 - AM2861真值表
#define MOTOR_FORWARD(motor) do { \
    HAL_GPIO_WritePin(motor##_A_PORT, motor##_A_PIN, GPIO_PIN_SET); \
    HAL_GPIO_WritePin(motor##_B_PORT, motor##_B_PIN, GPIO_PIN_RESET); \
} while(0)

#define MOTOR_BACKWARD(motor) do { \
    HAL_GPIO_WritePin(motor##_A_PORT, motor##_A_PIN, GPIO_PIN_RESET); \
    HAL_GPIO_WritePin(motor##_B_PORT, motor##_B_PIN, GPIO_PIN_SET); \
} while(0)

#define MOTOR_STOP(motor) do { \
    HAL_GPIO_WritePin(motor##_A_PORT, motor##_A_PIN, GPIO_PIN_RESET); \
    HAL_GPIO_WritePin(motor##_B_PORT, motor##_B_PIN, GPIO_PIN_RESET); \
} while(0)

#define MOTOR_BRAKE(motor) do { \
    HAL_GPIO_WritePin(motor##_A_PORT, motor##_A_PIN, GPIO_PIN_SET); \
    HAL_GPIO_WritePin(motor##_B_PORT, motor##_B_PIN, GPIO_PIN_SET); \
} while(0)

// 速度档位（软件PWM占空比）
#define DUTY_LOW   300   // 低速 - 30%占空比
#define DUTY_MID   500   // 中速 - 50%占空比
#define DUTY_HIGH  700   // 高速 - 70%占空比
#define CYCLE_TIME 1000  // PWM周期1ms
