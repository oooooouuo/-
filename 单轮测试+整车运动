// 系统自检
void System_SelfTest(void)
{
    printf("\r\n=== ROSMASTER X3 SYSTEM SELF-TEST ===\r\n");
    printf("STM32F103 + AM2861 x 4 Motor Drivers\r\n");

    // 测试所有电机引脚
    for(int i = 0; i < 4; i++) {
        printf("Testing %s motor...", motors[i].name);

        // 正向测试
        HAL_GPIO_WritePin(motors[i].portA, motors[i].pinA, GPIO_PIN_SET);
        HAL_Delay(200);
        HAL_GPIO_WritePin(motors[i].portA, motors[i].pinA, GPIO_PIN_RESET);

        // 反向测试
        HAL_GPIO_WritePin(motors[i].portB, motors[i].pinB, GPIO_PIN_SET);
        HAL_Delay(200);
        HAL_GPIO_WritePin(motors[i].portB, motors[i].pinB, GPIO_PIN_RESET);

        printf("OK\r\n");
    }
    printf("Self-test completed successfully!\r\n");
}

// 停止所有电机
void Stop_All_Motors(void)
{
    for(int i = 0; i < 4; i++) {
        MOTOR_STOP(motors[i].portA, motors[i].pinA, motors[i].portB, motors[i].pinB);
    }
    printf("All motors stopped\r\n");
}

// 紧急停止
void Emergency_Stop(void)
{
    Stop_All_Motors();
    motorEnabled = false;
    printf("!!! EMERGENCY STOP !!!\r\n");
    printf("Type 'enable' to re-enable motors\r\n");
}

// 单个电机测试
void Single_Motor_Test(MotorID motor)
{
    if(!motorEnabled) {
        printf("Motors disabled. Type 'enable' first.\r\n");
        return;
    }

    if(motor >= 4) return;

    printf("\r\n=== TESTING %s MOTOR ===\r\n", motors[motor].name);

    // 正向测试
    printf("%s motor FORWARD...\r\n", motors[motor].name);
    MOTOR_FORWARD(motors[motor].portA, motors[motor].pinA, motors[motor].portB, motors[motor].pinB);
    HAL_Delay(TEST_DURATION);

    // 停止
    printf("%s motor STOP...\r\n", motors[motor].name);
    MOTOR_STOP(motors[motor].portA, motors[motor].pinA, motors[motor].portB, motors[motor].pinB);
    HAL_Delay(500);

    // 反向测试
    printf("%s motor BACKWARD...\r\n", motors[motor].name);
    MOTOR_BACKWARD(motors[motor].portA, motors[motor].pinA, motors[motor].portB, motors[motor].pinB);
    HAL_Delay(TEST_DURATION);

    // 停止
    printf("%s motor STOP...\r\n", motors[motor].name);
    MOTOR_STOP(motors[motor].portA, motors[motor].pinA, motors[motor].portB, motors[motor].pinB);

    printf("%s motor test completed\r\n", motors[motor].name);
}

// 电机控制函数
void Motor_Control(MotorID motor, MoveDirection direction)
{
    if(!motorEnabled) return;

    const char* dir_names[] = {"STOP", "FORWARD", "BACKWARD", "LEFT", "RIGHT", "SPIN_LEFT", "SPIN_RIGHT"};

    if(motor == MOTOR_ALL) {
        printf("CAR MOVEMENT: %s\r\n", dir_names[direction]);
    }

    switch(motor) {
        case MOTOR_RR: // 右后轮
            switch(direction) {
                case DIR_FORWARD:
                    MOTOR_FORWARD(motors[0].portA, motors[0].pinA, motors[0].portB, motors[0].pinB);
                    break;
                case DIR_BACKWARD:
                    MOTOR_BACKWARD(motors[0].portA, motors[0].pinA, motors[0].portB, motors[0].pinB);
                    break;
                default:
                    MOTOR_STOP(motors[0].portA, motors[0].pinA, motors[0].portB, motors[0].pinB);
                    break;
            }
            break;

        case MOTOR_RF: // 右前轮
            switch(direction) {
                case DIR_FORWARD:
                    MOTOR_FORWARD(motors[1].portA, motors[1].pinA, motors[1].portB, motors[1].pinB);
                    break;
                case DIR_BACKWARD:
                    MOTOR_BACKWARD(motors[1].portA, motors[1].pinA, motors[1].portB, motors[1].pinB);
                    break;
                default:
                    MOTOR_STOP(motors[1].portA, motors[1].pinA, motors[1].portB, motors[1].pinB);
                    break;
            }
            break;

        case MOTOR_LR: // 左后轮
            switch(direction) {
                case DIR_FORWARD:
                    MOTOR_FORWARD(motors[2].portA, motors[2].pinA, motors[2].portB, motors[2].pinB);
                    break;
                case DIR_BACKWARD:
                    MOTOR_BACKWARD(motors[2].portA, motors[2].pinA, motors[2].portB, motors[2].pinB);
                    break;
                default:
                    MOTOR_STOP(motors[2].portA, motors[2].pinA, motors[2].portB, motors[2].pinB);
                    break;
            }
            break;

        case MOTOR_LF: // 左前轮
            switch(direction) {
                case DIR_FORWARD:
                    MOTOR_FORWARD(motors[3].portA, motors[3].pinA, motors[3].portB, motors[3].pinB);
                    break;
                case DIR_BACKWARD:
                    MOTOR_BACKWARD(motors[3].portA, motors[3].pinA, motors[3].portB, motors[3].pinB);
                    break;
                default:
                    MOTOR_STOP(motors[3].portA, motors[3].pinA, motors[3].portB, motors[3].pinB);
                    break;
            }
            break;

        case MOTOR_ALL: // 所有电机 - 整车运动
            switch(direction) {
                case DIR_FORWARD:
                    Car_Move_Forward();
                    break;
                case DIR_BACKWARD:
                    Car_Move_Backward();
                    break;
                case DIR_LEFT:
                    Car_Turn_Left();
                    break;
                case DIR_RIGHT:
                    Car_Turn_Right();
                    break;
                case DIR_SPIN_LEFT:
                    Car_Spin_Left();
                    break;
                case DIR_SPIN_RIGHT:
                    Car_Spin_Right();
                    break;
                default:
                    Stop_All_Motors();
                    break;
            }
            break;
    }
}

// 整车前进
void Car_Move_Forward(void)
{
    for(int i = 0; i < 4; i++) {
        MOTOR_FORWARD(motors[i].portA, motors[i].pinA, motors[i].portB, motors[i].pinB);
    }
}

// 整车后退
void Car_Move_Backward(void)
{
    for(int i = 0; i < 4; i++) {
        MOTOR_BACKWARD(motors[i].portA, motors[i].pinA, motors[i].portB, motors[i].pinB);
    }
}

// 整车左转
void Car_Turn_Left(void)
{
    // 左侧轮后退，右侧轮前进
    MOTOR_BACKWARD(motors[2].portA, motors[2].pinA, motors[2].portB, motors[2].pinB); // LR
    MOTOR_BACKWARD(motors[3].portA, motors[3].pinA, motors[3].portB, motors[3].pinB); // LF
    MOTOR_FORWARD(motors[0].portA, motors[0].pinA, motors[0].portB, motors[0].pinB);  // RR
    MOTOR_FORWARD(motors[1].portA, motors[1].pinA, motors[1].portB, motors[1].pinB);  // RF
}

// 整车右转
void Car_Turn_Right(void)
{
    // 右侧轮后退，左侧轮前进
    MOTOR_BACKWARD(motors[0].portA, motors[0].pinA, motors[0].portB, motors[0].pinB); // RR
    MOTOR_BACKWARD(motors[1].portA, motors[1].pinA, motors[1].portB, motors[1].pinB); // RF
    MOTOR_FORWARD(motors[2].portA, motors[2].pinA, motors[2].portB, motors[2].pinB);  // LR
    MOTOR_FORWARD(motors[3].portA, motors[3].pinA, motors[3].portB, motors[3].pinB);  // LF
}

// 整车原地左旋转
void Car_Spin_Left(void)
{
    // 左侧后退，右侧前进
    MOTOR_BACKWARD(motors[2].portA, motors[2].pinA, motors[2].portB, motors[2].pinB); // LR
    MOTOR_BACKWARD(motors[3].portA, motors[3].pinA, motors[3].portB, motors[3].pinB); // LF
    MOTOR_FORWARD(motors[0].portA, motors[0].pinA, motors[0].portB, motors[0].pinB);  // RR
    MOTOR_FORWARD(motors[1].portA, motors[1].pinA, motors[1].portB, motors[1].pinB);  // RF
}

// 整车原地右旋转
void Car_Spin_Right(void)
{
    // 右侧后退，左侧前进
    MOTOR_BACKWARD(motors[0].portA, motors[0].pinA, motors[0].portB, motors[0].pinB); // RR
    MOTOR_BACKWARD(motors[1].portA, motors[1].pinA, motors[1].portB, motors[1].pinB); // RF
    MOTOR_FORWARD(motors[2].portA, motors[2].pinA, motors[2].portB, motors[2].pinB);  // LR
    MOTOR_FORWARD(motors[3].portA, motors[3].pinA, motors[3].portB, motors[3].pinB);  // LF
}

// 串口命令处理
void Process_Command(char* command)
{
    // 单个电机测试命令
    if (strcmp(command, "test rr") == 0) {
        Single_Motor_Test(MOTOR_RR);
    }
    else if (strcmp(command, "test rf") == 0) {
        Single_Motor_Test(MOTOR_RF);
    }
    else if (strcmp(command, "test lr") == 0) {
        Single_Motor_Test(MOTOR_LR);
    }
    else if (strcmp(command, "test lf") == 0) {
        Single_Motor_Test(MOTOR_LF);
    }
    // 整车运动命令
    else if (strcmp(command, "forward") == 0) {
        Motor_Control(MOTOR_ALL, DIR_FORWARD);
    }
    else if (strcmp(command, "backward") == 0) {
        Motor_Control(MOTOR_ALL, DIR_BACKWARD);
    }
    else if (strcmp(command, "left") == 0) {
        Motor_Control(MOTOR_ALL, DIR_LEFT);
    }
    else if (strcmp(command, "right") == 0) {
        Motor_Control(MOTOR_ALL, DIR_RIGHT);
    }
    else if (strcmp(command, "spin left") == 0) {
        Motor_Control(MOTOR_ALL, DIR_SPIN_LEFT);
    }
    else if (strcmp(command, "spin right") == 0) {
        Motor_Control(MOTOR_ALL, DIR_SPIN_RIGHT);
    }
    else if (strcmp(command, "stop") == 0) {
        Stop_All_Motors();
    }
    else if (strcmp(command, "estop") == 0) {
        Emergency_Stop();
    }
    else if (strcmp(command, "enable") == 0) {
        motorEnabled = true;
        printf("Motors enabled\r\n");
    }
    else if (strcmp(command, "status") == 0) {
        printf("Motor status: %s\r\n", motorEnabled ? "ENABLED" : "DISABLED");
    }
    else if (strcmp(command, "help") == 0) {
        Print_Menu();
    }
    else {
        printf("Unknown command: %s\r\n", command);
        Print_Menu();
    }
}

// 串口输入处理
void Handle_UART_Input(void)
{
    if (HAL_UART_Receive(&huart1, (uint8_t*)&uartBuffer[uartIndex], 1, 10) == HAL_OK) {
        if (uartBuffer[uartIndex] == '\r' || uartBuffer[uartIndex] == '\n') {
            uartBuffer[uartIndex] = '\0';
            if (uartIndex > 0) {
                printf("\r\n> Executing: %s\r\n", uartBuffer);
                Process_Command(uartBuffer);
                printf("\r\n> ");
            }
            uartIndex = 0;
        } else {
            uartIndex++;
            if (uartIndex >= UART_BUFFER_SIZE - 1) {
                uartIndex = 0;
            }
        }
    }
}

