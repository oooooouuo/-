/**
  * @brief 命令处理
  */
void Process_Command(char* command)
{
    if (strncmp(command, "psw", 3) == 0) {
        int id, speed;
        if (sscanf(command, "psw %d %d", &id, &speed) == 2) {
            if(id>=0 && id<4) Set_Motor_Speed(id, speed);
            else printf("Invalid ID (0-3)\r\n");
        } else {
            printf("Usage: psw <motor> <0-100>\r\n");
        }
        return;
    }

    if (strcmp(command, "test0") == 0) {Test_Single_Motor(MOTOR_0);}
    else if (strcmp(command, "test1") == 0) {Test_Single_Motor(MOTOR_1);}
    else if (strcmp(command, "test2") == 0) {Test_Single_Motor(MOTOR_2);}
    else if (strcmp(command, "test3") == 0) {Test_Single_Motor(MOTOR_3);}
    else if (strcmp(command, "testall") == 0) {Test_All_Motors_Sequence();}
    else if (strcmp(command, "m0 fwd") == 0) {Single_Motor_Control(MOTOR_0, DIR_FORWARD);}
    else if (strcmp(command, "m0 bwd") == 0) {Single_Motor_Control(MOTOR_0, DIR_BACKWARD);}
    else if (strcmp(command, "m0 stop") == 0) {Single_Motor_Control(MOTOR_0, DIR_STOP);}
    else if (strcmp(command, "m1 fwd") == 0) {Single_Motor_Control(MOTOR_1, DIR_FORWARD);}
    else if (strcmp(command, "m1 bwd") == 0) {Single_Motor_Control(MOTOR_1, DIR_BACKWARD);}
    else if (strcmp(command, "m1 stop") == 0) {Single_Motor_Control(MOTOR_1, DIR_STOP);}
    else if (strcmp(command, "m2 fwd") == 0) {Single_Motor_Control(MOTOR_2, DIR_FORWARD);}
    else if (strcmp(command, "m2 bwd") == 0) {Single_Motor_Control(MOTOR_2, DIR_BACKWARD);}
    else if (strcmp(command, "m2 stop") == 0) {Single_Motor_Control(MOTOR_2, DIR_STOP);}
    else if (strcmp(command, "m3 fwd") == 0) {Single_Motor_Control(MOTOR_3, DIR_FORWARD);}
    else if (strcmp(command, "m3 bwd") == 0) {Single_Motor_Control(MOTOR_3, DIR_BACKWARD);}
    else if (strcmp(command, "m3 stop") == 0) {Single_Motor_Control(MOTOR_3, DIR_STOP);}
    else if (strcmp(command, "forward") == 0) {Car_Move_Forward();}
    else if (strcmp(command, "backward") == 0) {Car_Move_Backward();}
    else if (strcmp(command, "left") == 0) {Car_Turn_Left();}
    else if (strcmp(command, "right") == 0) {Car_Turn_Right();}
    else if (strcmp(command, "spinl") == 0) {Car_Spin_Left();}
    else if (strcmp(command, "spinr") == 0) {Car_Spin_Right();}
    else if (strcmp(command, "stop") == 0) {Stop_All_Motors();}
    else if (strcmp(command, "gpio") == 0) {GPIO_Pin_Test();}
    else if (strcmp(command, "status") == 0) {Print_Test_Results();}
    else if (strcmp(command, "enable") == 0) {motorEnabled = true; printf("Enabled\r\n");}
    else if (strcmp(command, "disable") == 0) {Stop_All_Motors(); motorEnabled = false; printf("Disabled\r\n");}
    else if (strcmp(command, "help") == 0) {Print_Menu();}
    else if (strlen(command) > 0) {printf("Unknown: '%s'\r\n", command);}
}

/**
  * @brief 串口输入处理
  */
void Handle_UART_Input(void)
{
    char c;
    if (HAL_UART_Receive(&huart1, (uint8_t*)&c, 1, 5) == HAL_OK) {
        if (c == '\r' || c == '\n') {
            uartBuffer[uartIndex] = '\0';
            if (uartIndex > 0) commandReady = true;
            else printf("\r\n> ");
            uartIndex = 0;
        } else if (c == '\b' || c == 127) {
            if (uartIndex > 0) {uartIndex--; printf("\b \b");}
        } else if (c >= 32 && c < 127) {
            if (uartIndex < UART_BUFFER_SIZE - 1) {
                uartBuffer[uartIndex++] = c;
                printf("%c", c);
            }
        }
    }
}

