}

void Stop_All_Motors(void)
{
    for(int i = 0; i < 4; i++) {
        MOTOR_STOP(motors[i].portA, motors[i].pinA, motors[i].portB, motors[i].pinB);
    }
    printf("All motors stopped\r\n");
}

void GPIO_Pin_Test(void)
{
    printf("\r\n=== GPIO PIN TEST ===\r\n");
    printf("Testing all GPIO pins individually...\r\n\r\n");

    for(int i = 0; i < 4; i++) {
        printf("Motor %d (%s):\r\n", i, motors[i].name);

        // 测试A相引脚
        printf("  PIN A: ");
        if(motors[i].portA == GPIOA) printf("PA");
        else if(motors[i].portA == GPIOB) printf("PB");
        else if(motors[i].portA == GPIOC) printf("PC");
        else if(motors[i].portA == GPIOD) printf("PD");
        printf("%d -> ", (int)(__builtin_ctz(motors[i].pinA)));

        HAL_GPIO_WritePin(motors[i].portA, motors[i].pinA, GPIO_PIN_SET);
        HAL_Delay(100);
        HAL_GPIO_WritePin(motors[i].portA, motors[i].pinA, GPIO_PIN_RESET);
        printf("OK\r\n");

        // 测试B相引脚
        printf("  PIN B: ");
        if(motors[i].portB == GPIOA) printf("PA");
        else if(motors[i].portB == GPIOB) printf("PB");
        else if(motors[i].portB == GPIOC) printf("PC");
        else if(motors[i].portB == GPIOD) printf("PD");
        printf("%d -> ", (int)(__builtin_ctz(motors[i].pinB)));

        HAL_GPIO_WritePin(motors[i].portB, motors[i].pinB, GPIO_PIN_SET);
        HAL_Delay(100);
        HAL_GPIO_WritePin(motors[i].portB, motors[i].pinB, GPIO_PIN_RESET);
        printf("OK\r\n\r\n");
    }

    printf("GPIO test completed!\r\n");
}

void Single_Motor_Control(MotorID motor, MotorDirection direction)
{
    if(!motorEnabled) {
        printf("Motors disabled!\r\n");
        return;
    }

    if(motor >= 4) return;

    const char* dir_names[] = {"STOP", "FORWARD", "BACKWARD"};
    printf("%s -> %s\r\n", motors[motor].name, dir_names[direction]);

    switch(direction) {
        case DIR_FORWARD:
            MOTOR_FORWARD(motors[motor].portA, motors[motor].pinA,
                         motors[motor].portB, motors[motor].pinB);
            break;

        case DIR_BACKWARD:
            MOTOR_BACKWARD(motors[motor].portA, motors[motor].pinA,
                          motors[motor].portB, motors[motor].pinB);
            break;

        default:
            MOTOR_STOP(motors[motor].portA, motors[motor].pinA,
                      motors[motor].portB, motors[motor].pinB);
            break;
    }
}

void Test_Single_Motor(MotorID motor)
{
    if(motor >= 4) return;

    printf("\r\n=== TESTING %s ===\r\n", motors[motor].name);

    // 正转测试
    printf(">>> FORWARD test (3 seconds)...\r\n");
    MOTOR_FORWARD(motors[motor].portA, motors[motor].pinA,
                 motors[motor].portB, motors[motor].pinB);
    HAL_Delay(TEST_DURATION);

    // 停止
    MOTOR_STOP(motors[motor].portA, motors[motor].pinA,
              motors[motor].portB, motors[motor].pinB);
    printf(">>> STOP (1 second)...\r\n");
    HAL_Delay(1000);

    // 反转测试
    printf(">>> BACKWARD test (3 seconds)...\r\n");
    MOTOR_BACKWARD(motors[motor].portA, motors[motor].pinA,
                  motors[motor].portB, motors[motor].pinB);
    HAL_Delay(TEST_DURATION);

    // 停止
    MOTOR_STOP(motors[motor].portA, motors[motor].pinA,
              motors[motor].portB, motors[motor].pinB);
    printf(">>> STOP\r\n");
    HAL_Delay(500);

    motors[motor].tested = true;

    printf("\r\nDid Motor %d work correctly? (y/n): ", motor);

    // 等待用户输入
    uartIndex = 0;
    while(1) {
        if (HAL_UART_Receive(&huart1, (uint8_t*)&uartBuffer[uartIndex], 1, 100) == HAL_OK) {
            if (uartBuffer[uartIndex] == 'y' || uartBuffer[uartIndex] == 'Y') {
                motors[motor].forward_ok = true;
                motors[motor].backward_ok = true;
                printf("YES\r\n");
                break;
            } else if (uartBuffer[uartIndex] == 'n' || uartBuffer[uartIndex] == 'N') {
                motors[motor].forward_ok = false;
                motors[motor].backward_ok = false;
                printf("NO\r\n");
                break;
            } else if (uartBuffer[uartIndex] == 'f' || uartBuffer[uartIndex] == 'F') {
                motors[motor].forward_ok = true;
                motors[motor].backward_ok = false;
                printf("FORWARD ONLY\r\n");
                break;
            } else if (uartBuffer[uartIndex] == 'b' || uartBuffer[uartIndex] == 'B') {
                motors[motor].forward_ok = false;
                motors[motor].backward_ok = true;
                printf("BACKWARD ONLY\r\n");
                break;
            }
        }
    }

    printf("%s test completed!\r\n", motors[motor].name);
}

void Test_All_Motors_Sequence(void)
{
    printf("\r\n=== SEQUENTIAL MOTOR TEST ===\r\n");
    printf("Will test all 4 motors one by one\r\n");
    printf("Press any key to start...\r\n");

    while(HAL_UART_Receive(&huart1, (uint8_t*)uartBuffer, 1, 100) != HAL_OK);

    for(int i = 0; i < 4; i++) {
        Test_Single_Motor(i);
        HAL_Delay(1000);
    }

    Print_Test_Results();
}

void Print_Test_Results(void)
{
    printf("\r\n=== TEST RESULTS ===\r\n");
    for(int i = 0; i < 4; i++) {
        printf("Motor %d (%s): ", i, motors[i].name);
        if(!motors[i].tested) {
            printf("NOT TESTED\r\n");
        } else if(motors[i].forward_ok && motors[i].backward_ok) {
            printf("OK (Both directions)\r\n");
        } else if(motors[i].forward_ok) {
            printf("FORWARD ONLY\r\n");
        } else if(motors[i].backward_ok) {
            printf("BACKWARD ONLY\r\n");
        } else {
            printf("NOT WORKING\r\n");
        }
    }
    printf("====================\r\n");
}

void Car_Move_Forward(void)
{
    printf("Car moving FORWARD\r\n");
    for(int i = 0; i < 4; i++) {
        MOTOR_FORWARD(motors[i].portA, motors[i].pinA, motors[i].portB, motors[i].pinB);
    }
}

void Car_Move_Backward(void)
{
    printf("Car moving BACKWARD\r\n");
    for(int i = 0; i < 4; i++) {
        MOTOR_BACKWARD(motors[i].portA, motors[i].pinA, motors[i].portB, motors[i].pinB);
    }
}

void Car_Turn_Left(void)
{
    printf("Car turning LEFT\r\n");
    // 左轮后退，右轮前进
    MOTOR_BACKWARD(motors[2].portA, motors[2].pinA, motors[2].portB, motors[2].pinB);
    MOTOR_BACKWARD(motors[3].portA, motors[3].pinA, motors[3].portB, motors[3].pinB);
    MOTOR_FORWARD(motors[0].portA, motors[0].pinA, motors[0].portB, motors[0].pinB);
    MOTOR_FORWARD(motors[1].portA, motors[1].pinA, motors[1].portB, motors[1].pinB);
}

void Car_Turn_Right(void)
{
    printf("Car turning RIGHT\r\n");
    // 右轮后退，左轮前进
    MOTOR_FORWARD(motors[2].portA, motors[2].pinA, motors[2].portB, motors[2].pinB);
    MOTOR_FORWARD(motors[3].portA, motors[3].pinA, motors[3].portB, motors[3].pinB);
    MOTOR_BACKWARD(motors[0].portA, motors[0].pinA, motors[0].portB, motors[0].pinB);
    MOTOR_BACKWARD(motors[1].portA, motors[1].pinA, motors[1].portB, motors[1].pinB);
}

void Car_Spin_Left(void)
{
    printf("Car spinning LEFT (in place)\r\n");
    MOTOR_BACKWARD(motors[2].portA, motors[2].pinA, motors[2].portB, motors[2].pinB);
    MOTOR_BACKWARD(motors[3].portA, motors[3].pinA, motors[3].portB, motors[3].pinB);
    MOTOR_FORWARD(motors[0].portA, motors[0].pinA, motors[0].portB, motors[0].pinB);
    MOTOR_FORWARD(motors[1].portA, motors[1].pinA, motors[1].portB, motors[1].pinB);
}

void Car_Spin_Right(void)
{
    printf("Car spinning RIGHT (in place)\r\n");
    MOTOR_FORWARD(motors[2].portA, motors[2].pinA, motors[2].portB, motors[2].pinB);
    MOTOR_FORWARD(motors[3].portA, motors[3].pinA, motors[3].portB, motors[3].pinB);
    MOTOR_BACKWARD(motors[0].portA, motors[0].pinA, motors[0].portB, motors[0].pinB);
    MOTOR_BACKWARD(motors[1].portA, motors[1].pinA, motors[1].portB, motors[1].pinB);
}

void Process_Command(char* command)
{
    // 单个电机测试
    if (strcmp(command, "test 0") == 0 || strcmp(command, "test0") == 0) {
        Test_Single_Motor(MOTOR_0);
    }
    else if (strcmp(command, "test 1") == 0 || strcmp(command, "test1") == 0) {
        Test_Single_Motor(MOTOR_1);
    }
    else if (strcmp(command, "test 2") == 0 || strcmp(command, "test2") == 0) {
        Test_Single_Motor(MOTOR_2);
    }
    else if (strcmp(command, "test 3") == 0 || strcmp(command, "test3") == 0) {
        Test_Single_Motor(MOTOR_3);
    }
    else if (strcmp(command, "testall") == 0) {
        Test_All_Motors_Sequence();
    }
    // 单个电机控制
    else if (strcmp(command, "m0 fwd") == 0) {
        Single_Motor_Control(MOTOR_0, DIR_FORWARD);
    }
    else if (strcmp(command, "m0 bwd") == 0) {
        Single_Motor_Control(MOTOR_0, DIR_BACKWARD);
    }
    else if (strcmp(command, "m0 stop") == 0) {
        Single_Motor_Control(MOTOR_0, DIR_STOP);
    }
    else if (strcmp(command, "m1 fwd") == 0) {
        Single_Motor_Control(MOTOR_1, DIR_FORWARD);
    }
    else if (strcmp(command, "m1 bwd") == 0) {
        Single_Motor_Control(MOTOR_1, DIR_BACKWARD);
    }
    else if (strcmp(command, "m1 stop") == 0) {
        Single_Motor_Control(MOTOR_1, DIR_STOP);
    }
    else if (strcmp(command, "m2 fwd") == 0) {
        Single_Motor_Control(MOTOR_2, DIR_FORWARD);
    }
    else if (strcmp(command, "m2 bwd") == 0) {
        Single_Motor_Control(MOTOR_2, DIR_BACKWARD);
    }
    else if (strcmp(command, "m2 stop") == 0) {
        Single_Motor_Control(MOTOR_2, DIR_STOP);
    }
    else if (strcmp(command, "m3 fwd") == 0) {
        Single_Motor_Control(MOTOR_3, DIR_FORWARD);
    }
    else if (strcmp(command, "m3 bwd") == 0) {
        Single_Motor_Control(MOTOR_3, DIR_BACKWARD);
    }
    else if (strcmp(command, "m3 stop") == 0) {
        Single_Motor_Control(MOTOR_3, DIR_STOP);
    }
    // 整车运动
    else if (strcmp(command, "forward") == 0) {
        Car_Move_Forward();
    }
    else if (strcmp(command, "backward") == 0) {
        Car_Move_Backward();
    }
    else if (strcmp(command, "left") == 0) {
        Car_Turn_Left();
    }
    else if (strcmp(command, "right") == 0) {
        Car_Turn_Right();
    }
    else if (strcmp(command, "spinl") == 0) {
        Car_Spin_Left();
    }
    else if (strcmp(command, "spinr") == 0) {
        Car_Spin_Right();
    }
    else if (strcmp(command, "stop") == 0) {
        Stop_All_Motors();
    }
    else if (strcmp(command, "gpio") == 0) {
        GPIO_Pin_Test();
    }
    else if (strcmp(command, "status") == 0) {
        Print_Test_Results();
    }
    else if (strcmp(command, "enable") == 0) {
        motorEnabled = true;
        printf("Motors ENABLED\r\n");
    }
    else if (strcmp(command, "disable") == 0) {
        Stop_All_Motors();
        motorEnabled = false;
        printf("Motors DISABLED\r\n");
    }
    else if (strcmp(command, "help") == 0) {
        Print_Menu();
    }
    else {
        printf("Unknown command: %s\r\n", command);
        printf("Type 'help' for command list\r\n");
    }
}

void Handle_UART_Input(void)
{
    if (HAL_UART_Receive(&huart1, (uint8_t*)&uartBuffer[uartIndex], 1, 10) == HAL_OK) {
        if (uartBuffer[uartIndex] == '\r' || uartBuffer[uartIndex] == '\n') {
            uartBuffer[uartIndex] = '\0';
            if (uartIndex > 0) {
                printf("\r\nExecuting: %s\r\n", uartBuffer);
                Process_Command(uartBuffer);
                printf("\r\n> ");
            }
            uartIndex = 0;
        } else if (uartBuffer[uartIndex] == '\b' || uartBuffer[uartIndex] == 127) {
            // 退格键处理
            if (uartIndex > 0) {
                uartIndex--;
                printf("\b \b");
            }
        } else {
            printf("%c", uartBuffer[uartIndex]);
            uartIndex++;
            if (uartIndex >= UART_BUFFER_SIZE - 1) {
                uartIndex = 0;
                printf("\r\nBuffer overflow! Resetting...\r\n> ");
            }
        }
    }
}

