// 根据AM2861芯片原理图定义控制引脚
#define M1_A_PIN       GPIO_PIN_6
#define M1_A_PORT      GPIOC
#define M1_B_PIN       GPIO_PIN_7
#define M1_B_PORT      GPIOC

#define M2_A_PIN       GPIO_PIN_8
