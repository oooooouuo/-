/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USART1_UART_Init();
  /* USER CODE BEGIN 2 */
  // 发送启动信息到串口
  printf("\r\n========================================\r\n");
  printf("AM2861电机控制系统启动成功！\r\n");
  printf("控制方式: GPIO电平控制\r\n");
  printf("电机驱动芯片: AM2861双H桥\r\n");
  printf("速度控制: 软件PWM占空比调节\r\n");
  printf("占空比档位: 低速=%d, 中速=%d, 高速=%d\r\n", DUTY_LOW, DUTY_MID, DUTY_HIGH);
  printf("开始电机测试循环...\r\n");
  printf("========================================\r\n\r\n");

  // 初始化时间戳
  lastToggleTime = HAL_GetTick();
  lastMotorTime = HAL_GetTick();
  lastDebugTime = HAL_GetTick();
  pwmCounter = 0;

  // 初始状态：停止所有电机
  MOTOR_STOP(M1);
  MOTOR_STOP(M2);
  MOTOR_STOP(M3);
  MOTOR_STOP(M4);
  printf("初始化完成，所有电机已停止\r\n\r\n");
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    uint32_t currentTime = HAL_GetTick();

    // 心跳灯 - 每200ms切换
    if (currentTime - lastToggleTime >= 200) {
      HAL_GPIO_TogglePin(GPIOC, GPIO_PIN_13);
      lastToggleTime = currentTime;
    }

    // 软件PWM更新 - 每1ms更新一次
    if (currentTime % 1 == 0) {
      Motor_PWM_Update();
    }

    // 每500ms输出一次调试信息
    if (currentTime - lastDebugTime >= 500) {
      Motor_Debug_Info();
      lastDebugTime = currentTime;
    }

    // 电机控制状态机（控制M1电机）
    switch (motorState) {
      case 0: // 正转2秒
        if (currentTime - lastMotorTime >= 2000) {
          motorState = 1;
          lastMotorTime = currentTime;
          printf(">>> 正转结束，进入停止状态\r\n");
        }
        break;

      case 1: // 停止0.5秒
        if (currentTime - lastMotorTime >= 500) {
          motorState = 2;
          lastMotorTime = currentTime;
          printf(">>> 停止结束，开始反转\r\n");
        }
        break;

      case 2: // 反转2秒
        if (currentTime - lastMotorTime >= 2000) {
          motorState = 3;
          lastMotorTime = currentTime;
          printf(">>> 反转结束，进入停止状态\r\n");
        }
        break;

      case 3: // 停止0.5秒
        if (currentTime - lastMotorTime >= 500) {
          motorState = 0;
          lastMotorTime = currentTime;
          // 切换速度档位
          speedIndex = (speedIndex + 1) % 3;
          printf(">>> 切换到%s档位，开始正转\r\n",
                 (speedIndex == 0) ? "低速" : (speedIndex == 1) ? "中速" : "高速");
        }
        break;
    }

    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

