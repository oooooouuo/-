/* Private typedef -----------------------------------------------------------*/
typedef enum {
    MOTOR_0 = 0,
    MOTOR_1 = 1,
    MOTOR_2 = 2,
    MOTOR_3 = 3,
} MotorID;

typedef enum {
    DIR_STOP = 0,
    DIR_FORWARD,
    DIR_BACKWARD
} MotorDirection;

typedef struct {
    GPIO_TypeDef* portA;
    uint16_t pinA;
    GPIO_TypeDef* portB;
    uint16_t pinB;
    const char* name;
    bool tested;
    bool forward_ok;
    bool backward_ok;
} MotorConfig;

/* Private define ------------------------------------------------------------*/
// 电机引脚配置 - RosMaster X3 (修正版 + 方向校正)
// Motor 0 (U16 M1): 交换A/B修正方向 ⚠️
#define M1_A_PORT      GPIOC
#define M1_A_PIN       GPIO_PIN_7   // PC7 - M1B (交换后)
#define M1_B_PORT      GPIOC
#define M1_B_PIN       GPIO_PIN_6   // PC6 - M1A (交换后)

// Motor 1 (U17 M2): 交换A/B修正方向 ⚠️
#define M2_A_PORT      GPIOC
#define M2_A_PIN       GPIO_PIN_9   // PC9 - M2B (交换后)
#define M2_B_PORT      GPIOC
#define M2_B_PIN       GPIO_PIN_8   // PC8 - M2A (交换后)

// Motor 2 (U12 M3): PA11(M3A), PA8(M3B)
#define M3_A_PORT      GPIOA
#define M3_A_PIN       GPIO_PIN_11  // PA11 - M3A
#define M3_B_PORT      GPIOA
#define M3_B_PIN       GPIO_PIN_8   // PA8 - M3B

// Motor 3 (U13 M4): PB0(M4A), PB1(M4B)
#define M4_A_PORT      GPIOB
#define M4_A_PIN       GPIO_PIN_0   // PB0 - M4A
#define M4_B_PORT      GPIOB
#define M4_B_PIN       GPIO_PIN_1   // PB1 - M4B

#define UART_BUFFER_SIZE 64
#define TEST_DURATION 3000

/* Private macro -------------------------------------------------------------*/
#define MOTOR_FORWARD(portA, pinA, portB, pinB) do { \
    HAL_GPIO_WritePin(portA, pinA, GPIO_PIN_SET); \
    HAL_GPIO_WritePin(portB, pinB, GPIO_PIN_RESET); \
} while(0)

#define MOTOR_BACKWARD(portA, pinA, portB, pinB) do { \
    HAL_GPIO_WritePin(portA, pinA, GPIO_PIN_RESET); \
    HAL_GPIO_WritePin(portB, pinB, GPIO_PIN_SET); \
} while(0)

#define MOTOR_STOP(portA, pinA, portB, pinB) do { \
    HAL_GPIO_WritePin(portA, pinA, GPIO_PIN_RESET); \
    HAL_GPIO_WritePin(portB, pinB, GPIO_PIN_RESET); \
} while(0)

/* Private variables ---------------------------------------------------------*/
UART_HandleTypeDef huart1;

uint32_t lastToggleTime = 0;
char uartBuffer[UART_BUFFER_SIZE];
uint8_t uartIndex = 0;
bool motorEnabled = true;

MotorConfig motors[4] = {
    {M1_A_PORT, M1_A_PIN, M1_B_PORT, M1_B_PIN, "Motor-1", false, false, false},
    {M2_A_PORT, M2_A_PIN, M2_B_PORT, M2_B_PIN, "Motor-2", false, false, false},
    {M3_A_PORT, M3_A_PIN, M3_B_PORT, M3_B_PIN, "Motor-3", false, false, false},
    {M4_A_PORT, M4_A_PIN, M4_B_PORT, M4_B_PIN, "Motor-4", false, false, false}
