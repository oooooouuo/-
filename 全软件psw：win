/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();
    MX_USART1_UART_Init();
    MX_TIM2_Init();  // 仅初始化TIM2

    // === 发送启动信息 ===
    printf("\r\n\r\n");
    printf("========================================\r\n");
    printf("   ROSMASTER X3 DIAGNOSTIC SYSTEM\r\n");
    printf("   SOFTWARE PWM ONLY (ALL MOTORS)\r\n");
    printf("========================================\r\n");
    printf("STM32F103 + 4x Motor Drivers\r\n");
    printf("PWM Update: TIM2 Interrupt @ 1kHz\r\n");
    printf("Build: %s %s\r\n", __DATE__, __TIME__);
    printf("========================================\r\n");

    Stop_All_Motors();

    printf("\r\nSystem ready!\r\n");
    printf("Type 'help' for commands or 'testall' to start\r\n");
    printf("Use 'psw <motor> <0-100>' to set speed\r\n");
    printf("\r\n> ");

    lastToggleTime = HAL_GetTick();

    while (1)
    {
        uint32_t currentTime = HAL_GetTick();

        // LED心跳
        if (currentTime - lastToggleTime >= 500) {
            HAL_GPIO_TogglePin(GPIOC, GPIO_PIN_13);
            lastToggleTime = currentTime;
        }

        // 处理串口输入
        Handle_UART_Input();

        // 在主循环处理命令（关键修复！）
        if (commandReady) {
            Process_Command(uartBuffer);
            commandReady = false;
            printf("\r\n> ");
        }
    }
}

/**
  * @brief 停止所有电机
  */
void Stop_All_Motors(void)
{
    for(int i = 0; i < 4; i++) {
        motors[i].current_dir = DIR_STOP;
        HAL_GPIO_WritePin(motors[i].portA, motors[i].pinA, GPIO_PIN_RESET);
        HAL_GPIO_WritePin(motors[i].portB, motors[i].pinB, GPIO_PIN_RESET);
    }
}

/**
  * @brief 设置电机速度（立即生效）
  */
void Set_Motor_Speed(MotorID motor, uint8_t speed)
{
    if (speed > 100) speed = 100;
    motors[motor].speed = speed;
    printf("Motor %d (%s) speed: %d%%\r\n", motor, motors[motor].name, speed);
}

/**
  * @brief PWM更新核心函数（TIM2中断调用）
  */
void Update_Motor_PWM(void)
{
    pwmCounter = (pwmCounter + 1) % SOFTWARE_PWM_CYCLE;

    for (int i = 0; i < 4; i++) {
        // 电机禁用或停止时强制关闭
        if (!motorEnabled || motors[i].current_dir == DIR_STOP) {
            HAL_GPIO_WritePin(motors[i].portA, motors[i].pinA, GPIO_PIN_RESET);
            HAL_GPIO_WritePin(motors[i].portB, motors[i].pinB, GPIO_PIN_RESET);
            continue;
        }

        // 计算有效占空比
        uint8_t duty_cycle = (motors[i].speed * SOFTWARE_PWM_CYCLE) / 100;

        if (pwmCounter < duty_cycle) {
            // 有效周期内 - 按方向驱动
            if (motors[i].current_dir == DIR_FORWARD) {
                HAL_GPIO_WritePin(motors[i].portA, motors[i].pinA, GPIO_PIN_SET);
                HAL_GPIO_WritePin(motors[i].portB, motors[i].pinB, GPIO_PIN_RESET);
            } else {
                HAL_GPIO_WritePin(motors[i].portA, motors[i].pinA, GPIO_PIN_RESET);
                HAL_GPIO_WritePin(motors[i].portB, motors[i].pinB, GPIO_PIN_SET);
            }
        } else {
            // 关闭周期 - 制动
            HAL_GPIO_WritePin(motors[i].portA, motors[i].pinA, GPIO_PIN_RESET);
            HAL_GPIO_WritePin(motors[i].portB, motors[i].pinB, GPIO_PIN_RESET);
        }
    }
}

/**
  * @brief 单电机控制
  */
void Single_Motor_Control(MotorID motor, MotorDirection direction)
{
    if(!motorEnabled) {
        printf("Motors disabled!\r\n");
        return;
    }
    if(motor >= 4) return;

    const char* dir_names[] = {"STOP", "FORWARD", "BACKWARD"};
    motors[motor].current_dir = direction;
    printf("%s -> %s (Speed: %d%%)\r\n", motors[motor].name, dir_names[direction], motors[motor].speed);
}

/**
  * @brief 测试单电机（带10秒超时）
  */
void Test_Single_Motor(MotorID motor)
{
    if(motor >= 4) return;

    printf("\r\n=== TESTING %s ===\r\n", motors[motor].name);
    uint8_t original_speed = motors[motor].speed;

    // 测试3个速度档位
    const uint8_t test_speeds[] = {30, 60, 90};
    const char* speed_names[] = {"LOW", "MED", "HIGH"};

    for(int i = 0; i < 3; i++) {
        Set_Motor_Speed(motor, test_speeds[i]);
        printf(">>> %s speed FORWARD (2s)...", speed_names[i]);
        Single_Motor_Control(motor, DIR_FORWARD);
        HAL_Delay(2000);

        Single_Motor_Control(motor, DIR_STOP);
        HAL_Delay(500);
    }

    HAL_Delay(1000); // 停顿1秒

    for(int i = 0; i < 3; i++) {
        Set_Motor_Speed(motor, test_speeds[i]);
        printf(">>> %s speed BACKWARD (2s)...", speed_names[i]);
        Single_Motor_Control(motor, DIR_BACKWARD);
        HAL_Delay(2000);

        Single_Motor_Control(motor, DIR_STOP);
        HAL_Delay(500);
    }

    Set_Motor_Speed(motor, original_speed);
    motors[motor].tested = true;

    // 超时10秒等待用户反馈
    printf("\r\nDid %s work? (y/n/f/b): ", motors[motor].name);
    uint32_t inputStart = HAL_GetTick();
    uartIndex = 0;

    while((HAL_GetTick() - inputStart) < 10000) {
        if (HAL_UART_Receive(&huart1, (uint8_t*)&uartBuffer[uartIndex], 1, 10) == HAL_OK) {
            char c = uartBuffer[uartIndex];
            if(c=='y'||c=='Y'){motors[motor].forward_ok=1;motors[motor].backward_ok=1;printf("OK\r\n");return;}
            if(c=='n'||c=='N'){motors[motor].forward_ok=0;motors[motor].backward_ok=0;printf("FAIL\r\n");return;}
            if(c=='f'||c=='F'){motors[motor].forward_ok=1;motors[motor].backward_ok=0;printf("FWD ONLY\r\n");return;}
            if(c=='b'||c=='B'){motors[motor].forward_ok=0;motors[motor].backward_ok=1;printf("BWD ONLY\r\n");return;}
        }
    }

    printf("\r\nTimeout! Test incomplete.\r\n");
}

/**
  * @brief 测试所有电机
  */
void Test_All_Motors_Sequence(void)
{
    printf("\r\n=== SEQUENTIAL MOTOR TEST ===\r\n");
    printf("Press any key to start...\r\n");
    while(HAL_UART_Receive(&huart1, (uint8_t*)uartBuffer, 1, 100) != HAL_OK);

    for(int i = 0; i < 4; i++) {
        Test_Single_Motor(i);
        HAL_Delay(1000);
    }

    Print_Test_Results();
}

/**
  * @brief 打印测试结果
  */
void Print_Test_Results(void)
{
    printf("\r\n=== TEST RESULTS ===\r\n");
    for(int i = 0; i < 4; i++) {
        printf("%d:%s ", i, motors[i].name);
        if(!motors[i].tested) printf("NOT_TESTED\r\n");
        else if(motors[i].forward_ok && motors[i].backward_ok) printf("OK\r\n");
        else if(motors[i].forward_ok) printf("FWD_ONLY\r\n");
        else if(motors[i].backward_ok) printf("BWD_ONLY\r\n");
        else printf("FAIL\r\n");
    }
    printf("====================\r\n");
}

