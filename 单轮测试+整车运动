/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
    /* MCU Configuration--------------------------------------------------------*/
    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();
    MX_USART1_UART_Init();

    /* USER CODE BEGIN 2 */
    printf("\r\n\r\n");
    printf("========================================\r\n");
    printf("   ROSMASTER X3 DIAGNOSTIC SYSTEM\r\n");
    printf("   FULLY CORRECTED VERSION\r\n");
    printf("========================================\r\n");
    printf("STM32F103 + 4x Motor Drivers\r\n");
    printf("Build: %s %s\r\n", __DATE__, __TIME__);
    printf("========================================\r\n");
    printf("Motor 0: PC7(A), PC6(B) <- DIR FIXED\r\n");
    printf("Motor 1: PC9(A), PC8(B) <- DIR FIXED\r\n");
    printf("Motor 2: PA11(A), PA8(B)\r\n");
    printf("Motor 3: PB0(A), PB1(B)\r\n");
    printf("========================================\r\n");

    // 初始化所有电机为停止状态
    Stop_All_Motors();

    printf("\r\nSystem ready!\r\n");
    printf("Type 'help' for commands or 'testall' to start diagnosis\r\n");
    printf("\r\n> ");

    lastToggleTime = HAL_GetTick();

    /* USER CODE END 2 */

    /* Infinite loop */
    while (1)
    {
        uint32_t currentTime = HAL_GetTick();

        // LED心跳 - PC13闪烁表示系统运行
        if (currentTime - lastToggleTime >= 500) {
            HAL_GPIO_TogglePin(GPIOC, GPIO_PIN_13);
            lastToggleTime = currentTime;
        }

        // 处理串口输入
        Handle_UART_Input();
    }
}

