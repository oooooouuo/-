/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();
    MX_USART1_UART_Init();
    MX_TIM2_Init();

    printf("\r\n\r\n");
    printf("========================================\r\n");
    printf("   ROSMASTER X3 - FINAL VERSION\r\n");
    printf("========================================\r\n");
    printf("Build: %s %s\r\n", __DATE__, __TIME__);
    printf("========================================\r\n");

    Stop_All_Motors();

    printf("\r\nSystem ready! Type 'help'\r\n");
    printf("\r\n> ");

    lastToggleTime = HAL_GetTick();

    while (1)
    {
        uint32_t currentTime = HAL_GetTick();

        if (currentTime - lastToggleTime >= 500) {
            HAL_GPIO_TogglePin(GPIOC, GPIO_PIN_13);
            lastToggleTime = currentTime;
        }

        Handle_UART_Input();

        if (commandReady) {
            Process_Command(uartBuffer);
            commandReady = false;
            printf("\r\n> ");
        }
    }
}

/**
  * @brief 停止所有电机
  */
void Stop_All_Motors(void)
{
    for(int i = 0; i < 4; i++) {
        motors[i].current_dir = DIR_STOP;
        HAL_GPIO_WritePin(motors[i].portA, motors[i].pinA, GPIO_PIN_RESET);
        HAL_GPIO_WritePin(motors[i].portB, motors[i].pinB, GPIO_PIN_RESET);
    }
}

/**
  * @brief 设置电机速度
  */
void Set_Motor_Speed(MotorID motor, uint8_t speed)
{
    if (speed > 100) speed = 100;
    motors[motor].speed = speed;
    printf("Motor %d speed: %d%%\r\n", motor, speed);
}

/**
  * @brief PWM更新
  */
void Update_Motor_PWM(void)
{
    pwmCounter = (pwmCounter + 1) % SOFTWARE_PWM_CYCLE;

    for (int i = 0; i < 4; i++) {
        if (!motorEnabled || motors[i].current_dir == DIR_STOP) {
            HAL_GPIO_WritePin(motors[i].portA, motors[i].pinA, GPIO_PIN_RESET);
            HAL_GPIO_WritePin(motors[i].portB, motors[i].pinB, GPIO_PIN_RESET);
            continue;
        }

        uint8_t duty_cycle = (motors[i].speed * SOFTWARE_PWM_CYCLE) / 100;

        if (pwmCounter < duty_cycle) {
            if (motors[i].current_dir == DIR_FORWARD) {
                HAL_GPIO_WritePin(motors[i].portA, motors[i].pinA, GPIO_PIN_SET);
                HAL_GPIO_WritePin(motors[i].portB, motors[i].pinB, GPIO_PIN_RESET);
            } else {
                HAL_GPIO_WritePin(motors[i].portA, motors[i].pinA, GPIO_PIN_RESET);
                HAL_GPIO_WritePin(motors[i].portB, motors[i].pinB, GPIO_PIN_SET);
            }
        } else {
            HAL_GPIO_WritePin(motors[i].portA, motors[i].pinA, GPIO_PIN_RESET);
            HAL_GPIO_WritePin(motors[i].portB, motors[i].pinB, GPIO_PIN_RESET);
        }
    }
}

/**
  * @brief 单电机控制
  */
void Single_Motor_Control(MotorID motor, MotorDirection direction)
{
    if(!motorEnabled) {
        printf("Motors disabled!\r\n");
        return;
    }
    if(motor >= 4) return;

    const char* dir_names[] = {"STOP", "FWD", "BWD"};
    motors[motor].current_dir = direction;
    printf("%s -> %s (%d%%)\r\n", motors[motor].name, dir_names[direction], motors[motor].speed);
}

/**
  * @brief 测试单电机（2秒每档）
  */
void Test_Single_Motor(MotorID motor)
{
    if(motor >= 4) return;

    printf("\r\n=== Testing %s ===\r\n", motors[motor].name);
    uint8_t original_speed = motors[motor].speed;

    uint8_t speeds[] = {30, 60, 90};
    for(int i = 0; i < 3; i++) {
        Set_Motor_Speed(motor, speeds[i]);
        printf(">>> %d%% FWD (2s)...", speeds[i]);
        Single_Motor_Control(motor, DIR_FORWARD);
        HAL_Delay(2000);
        Single_Motor_Control(motor, DIR_STOP);
        HAL_Delay(500);
    }

    HAL_Delay(1000);

    for(int i = 0; i < 3; i++) {
        Set_Motor_Speed(motor, speeds[i]);
        printf(">>> %d%% BWD (2s)...", speeds[i]);
        Single_Motor_Control(motor, DIR_BACKWARD);
        HAL_Delay(2000);
        Single_Motor_Control(motor, DIR_STOP);
        HAL_Delay(500);
    }

    Set_Motor_Speed(motor, original_speed);
    motors[motor].tested = true;
    printf("\r\n%s test completed\r\n", motors[motor].name);
}

/**
  * @brief 测试所有电机
  */
void Test_All_Motors_Sequence(void)
{
    printf("\r\n=== Auto Test All (2s/档) ===\r\n");
    for(int i = 0; i < 4; i++) {
        Test_Single_Motor(i);
        HAL_Delay(1000);
    }
    Print_Test_Results();
}

/**
  * @brief 打印测试结果
  */
void Print_Test_Results(void)
{
    printf("\r\n=== RESULTS ===\r\n");
    for(int i = 0; i < 4; i++) {
        printf("%d:%s %s\r\n", i, motors[i].name, motors[i].tested ? "OK" : "NOT_TESTED");
    }
}

