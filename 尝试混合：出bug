// 硬件PWM控制函数
void Hardware_PWM_Forward(MotorID motor)
{
    if (motors[motor].use_hardware_pwm && motors[motor].tim) {
        uint16_t pulse = (motors[motor].speed * PWM_PERIOD) / 100;
        __HAL_TIM_SET_COMPARE(motors[motor].tim, motors[motor].chA, pulse);
        __HAL_TIM_SET_COMPARE(motors[motor].tim, motors[motor].chB, 0);
    }
}

void Hardware_PWM_Backward(MotorID motor)
{
    if (motors[motor].use_hardware_pwm && motors[motor].tim) {
        uint16_t pulse = (motors[motor].speed * PWM_PERIOD) / 100;
        __HAL_TIM_SET_COMPARE(motors[motor].tim, motors[motor].chA, 0);
        __HAL_TIM_SET_COMPARE(motors[motor].tim, motors[motor].chB, pulse);
    }
}

void Hardware_PWM_Stop(MotorID motor)
{
    if (motors[motor].use_hardware_pwm && motors[motor].tim) {
        __HAL_TIM_SET_COMPARE(motors[motor].tim, motors[motor].chA, 0);
        __HAL_TIM_SET_COMPARE(motors[motor].tim, motors[motor].chB, 0);
    }
}

// PWM更新函数（控制电机）
void Update_Motor_PWM(void)
{
    pwmCounter = (pwmCounter + 1) % SOFTWARE_PWM_CYCLE;

    for (int i = 0; i < 4; i++) {
        if (!globalEnabled || !motors[i].enabled) {
            if (motors[i].use_hardware_pwm) {
                Hardware_PWM_Stop(i);
            } else {
                HAL_GPIO_WritePin(motors[i].portA, motors[i].pinA, GPIO_PIN_RESET);
                HAL_GPIO_WritePin(motors[i].portB, motors[i].pinB, GPIO_PIN_RESET);
            }
            continue;
        }

        if (motors[i].use_hardware_pwm) {
            switch (motors[i].current_dir) {
                case DIR_FORWARD:
                    Hardware_PWM_Forward(i);
                    break;
                case DIR_BACKWARD:
                    Hardware_PWM_Backward(i);
                    break;
                case DIR_STOP:
                    Hardware_PWM_Stop(i);
                    break;
            }
        } else {
            uint16_t duty_cycle = (motors[i].speed * SOFTWARE_PWM_CYCLE) / 100;
            if (pwmCounter < duty_cycle) {
                switch (motors[i].current_dir) {
                    case DIR_FORWARD:
                        HAL_GPIO_WritePin(motors[i].portA, motors[i].pinA, GPIO_PIN_SET);
                        HAL_GPIO_WritePin(motors[i].portB, motors[i].pinB, GPIO_PIN_RESET);
                        break;
                    case DIR_BACKWARD:
                        HAL_GPIO_WritePin(motors[i].portA, motors[i].pinA, GPIO_PIN_RESET);
                        HAL_GPIO_WritePin(motors[i].portB, motors[i].pinB, GPIO_PIN_SET);
                        break;
                    case DIR_STOP:
                        HAL_GPIO_WritePin(motors[i].portA, motors[i].pinA, GPIO_PIN_RESET);
                        HAL_GPIO_WritePin(motors[i].portB, motors[i].pinB, GPIO_PIN_RESET);
                        break;
                }
            } else {
                HAL_GPIO_WritePin(motors[i].portA, motors[i].pinA, GPIO_PIN_RESET);
                HAL_GPIO_WritePin(motors[i].portB, motors[i].pinB, GPIO_PIN_RESET);
            }
        }
    }
}

// 电机速度设置
void Set_Motor_Speed(MotorID motor, uint8_t speed)
{
    if (speed > 100) speed = 100;
    motors[motor].speed = speed;
    printf("Motor %d speed set to %d%%\r\n", motor, speed);
}

// 停止所有电机
void Stop_All_Motors(void)
{
    for(int i = 0; i < 4; i++) {
        motors[i].current_dir = DIR_STOP;
        motors[i].enabled = false;
    }
    printf("All motors stopped\r\n");
}

// 单电机控制
void Single_Motor_Control(MotorID motor, MotorDirection direction)
{
    if(!globalEnabled) {
        printf("Motors disabled!\r\n");
        return;
    }
    if(motor >= 4) return;

    const char* dir_names[] = {"STOP", "FORWARD", "BACKWARD"};
    printf("%s -> %s (Speed: %d%%)\r\n", motors[motor].name, dir_names[direction], motors[motor].speed);

    motors[motor].current_dir = direction;
    motors[motor].enabled = (direction != DIR_STOP);

    if (direction == DIR_FORWARD) motors[motor].forward_ok = true;
    else if (direction == DIR_BACKWARD) motors[motor].backward_ok = true;
}

// 测试单电机
void Test_Single_Motor(MotorID motor)
{
    if(motor >= 4) return;

    printf("\r\n=== TESTING %s ===\r\n", motors[motor].name);

    uint8_t original_speed = motors[motor].speed;
    Set_Motor_Speed(motor, 50);

    printf(">>> FORWARD test (3 seconds)...\r\n");
    Single_Motor_Control(motor, DIR_FORWARD);
    HAL_Delay(TEST_DURATION);

    Single_Motor_Control(motor, DIR_STOP);
    printf(">>> STOP (1 second)...\r\n");
    HAL_Delay(1000);

    printf(">>> BACKWARD test (3 seconds)...\r\n");
    Single_Motor_Control(motor, DIR_BACKWARD);
    HAL_Delay(TEST_DURATION);

    Single_Motor_Control(motor, DIR_STOP);
    printf(">>> STOP\r\n");

    Set_Motor_Speed(motor, original_speed);
    HAL_Delay(500);

    motors[motor].tested = true;

    printf("\r\nDid Motor %d work correctly? (y/n/f/b): ", motor);

    uartIndex = 0;
    while(1) {
        if (HAL_UART_Receive(&huart1, (uint8_t*)&uartBuffer[uartIndex], 1, 100) == HAL_OK) {
            if (uartBuffer[uartIndex] == 'y' || uartBuffer[uartIndex] == 'Y') {
                motors[motor].forward_ok = true;
                motors[motor].backward_ok = true;
                printf("YES\r\n");
                break;
            } else if (uartBuffer[uartIndex] == 'n' || uartBuffer[uartIndex] == 'N') {
                motors[motor].forward_ok = false;
                motors[motor].backward_ok = false;
                printf("NO\r\n");
                break;
            } else if (uartBuffer[uartIndex] == 'f' || uartBuffer[uartIndex] == 'F') {
                motors[motor].forward_ok = true;
                motors[motor].backward_ok = false;
                printf("FORWARD ONLY\r\n");
                break;
            } else if (uartBuffer[uartIndex] == 'b' || uartBuffer[uartIndex] == 'B') {
                motors[motor].forward_ok = false;
                motors[motor].backward_ok = true;
                printf("BACKWARD ONLY\r\n");
                break;
            }
        }
    }

    printf("%s test completed!\r\n", motors[motor].name);
}

// 测试所有电机
void Test_All_Motors_Sequence(void)
{
    printf("\r\n=== SEQUENTIAL MOTOR TEST ===\r\n");
    printf("Will test all 4 motors one by one\r\n");
    printf("Press any key to start...\r\n");

    while(HAL_UART_Receive(&huart1, (uint8_t*)uartBuffer, 1, 100) != HAL_OK);

    for(int i = 0; i < 4; i++) {
        Test_Single_Motor(i);
        HAL_Delay(1000);
    }

    Print_Test_Results();
}

// 打印测试结果
void Print_Test_Results(void)
{
    printf("\r\n=== TEST RESULTS ===\r\n");
    for(int i = 0; i < 4; i++) {
        printf("Motor %d (%s): ", i, motors[i].name);
        if(!motors[i].tested) {
            printf("NOT TESTED\r\n");
        } else if(motors[i].forward_ok && motors[i].backward_ok) {
            printf("OK (Both directions)\r\n");
        } else if(motors[i].forward_ok) {
            printf("FORWARD ONLY\r\n");
        } else if(motors[i].backward_ok) {
            printf("BACKWARD ONLY\r\n");
        } else {
            printf("NOT WORKING\r\n");
        }
    }
    printf("====================\r\n");
}

