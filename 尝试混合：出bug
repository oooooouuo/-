    motors[2].current_dir = DIR_FORWARD;
    motors[3].current_dir = DIR_FORWARD;
    for(int i = 0; i < 4; i++) {
        motors[i].enabled = true;
    }
}

// GPIO测试函数
void GPIO_Pin_Test(void)
{
    printf("\r\n=== GPIO PIN TEST ===\r\n");
    printf("Testing all GPIO pins individually...\r\n\r\n");

    for(int i = 0; i < 4; i++) {
        printf("Motor %d (%s):\r\n", i, motors[i].name);

        printf("  PIN A: ");
        if(motors[i].portA == GPIOA) printf("PA");
        else if(motors[i].portA == GPIOB) printf("PB");
        else if(motors[i].portA == GPIOC) printf("PC");
        printf("%d -> ", (int)(__builtin_ctz(motors[i].pinA)));

        HAL_GPIO_WritePin(motors[i].portA, motors[i].pinA, GPIO_PIN_SET);
        HAL_Delay(100);
        HAL_GPIO_WritePin(motors[i].portA, motors[i].pinA, GPIO_PIN_RESET);
        printf("OK\r\n");

        printf("  PIN B: ");
        if(motors[i].portB == GPIOA) printf("PA");
        else if(motors[i].portB == GPIOB) printf("PB");
        else if(motors[i].portB == GPIOC) printf("PC");
        printf("%d -> ", (int)(__builtin_ctz(motors[i].pinB)));

        HAL_GPIO_WritePin(motors[i].portB, motors[i].pinB, GPIO_PIN_SET);
        HAL_Delay(100);
        HAL_GPIO_WritePin(motors[i].portB, motors[i].pinB, GPIO_PIN_RESET);
        printf("OK\r\n\r\n");
    }

    printf("GPIO test completed!\r\n");
}

// 串口命令处理
void Process_Command(char* command)
{
    if (strncmp(command, "psw", 3) == 0) {
        int motor_id;
        int speed;
        if (sscanf(command, "psw %d %d", &motor_id, &speed) == 2) {
            if (motor_id >= 0 && motor_id < 4) {
                Set_Motor_Speed(motor_id, speed);
            } else {
                printf("Invalid motor ID. Must be 0-3.\r\n");
            }
        } else {
            printf("Use: 'psw <motor_id> <speed>' (speed 0-100)\r\n");
        }
        return;
    }

    if (strcmp(command, "test 0") == 0 || strcmp(command, "test0") == 0) {
        Test_Single_Motor(MOTOR_0);
    }
    else if (strcmp(command, "test 1") == 0 || strcmp(command, "test1") == 0) {
        Test_Single_Motor(MOTOR_1);
    }
    else if (strcmp(command, "test 2") == 0 || strcmp(command, "test2") == 0) {
        Test_Single_Motor(MOTOR_2);
    }
    else if (strcmp(command, "test 3") == 0 || strcmp(command, "test3") == 0) {
        Test_Single_Motor(MOTOR_3);
    }
    else if (strcmp(command, "testall") == 0) {
        Test_All_Motors_Sequence();
    }
    else if (strcmp(command, "m0 fwd") == 0) {
        Single_Motor_Control(MOTOR_0, DIR_FORWARD);
    }
    else if (strcmp(command, "m0 bwd") == 0) {
        Single_Motor_Control(MOTOR_0, DIR_BACKWARD);
    }
    else if (strcmp(command, "m0 stop") == 0) {
        Single_Motor_Control(MOTOR_0, DIR_STOP);
    }
    else if (strcmp(command, "m1 fwd") == 0) {
        Single_Motor_Control(MOTOR_1, DIR_FORWARD);
    }
    else if (strcmp(command, "m1 bwd") == 0) {
        Single_Motor_Control(MOTOR_1, DIR_BACKWARD);
    }
    else if (strcmp(command, "m1 stop") == 0) {
        Single_Motor_Control(MOTOR_1, DIR_STOP);
    }
    else if (strcmp(command, "m2 fwd") == 0) {
        Single_Motor_Control(MOTOR_2, DIR_FORWARD);
    }
    else if (strcmp(command, "m2 bwd") == 0) {
        Single_Motor_Control(MOTOR_2, DIR_BACKWARD);
    }
    else if (strcmp(command, "m2 stop") == 0) {
        Single_Motor_Control(MOTOR_2, DIR_STOP);
    }
    else if (strcmp(command, "m3 fwd") == 0) {
        Single_Motor_Control(MOTOR_3, DIR_FORWARD);
    }
    else if (strcmp(command, "m3 bwd") == 0) {
        Single_Motor_Control(MOTOR_3, DIR_BACKWARD);
    }
    else if (strcmp(command, "m3 stop") == 0) {
        Single_Motor_Control(MOTOR_3, DIR_STOP);
    }
    else if (strcmp(command, "forward") == 0) {
        Car_Move_Forward();
    }
    else if (strcmp(command, "backward") == 0) {
        Car_Move_Backward();
    }
    else if (strcmp(command, "left") == 0) {
        Car_Turn_Left();
    }
    else if (strcmp(command, "right") == 0) {
        Car_Turn_Right();
    }
    else if (strcmp(command, "spinl") == 0) {
        Car_Spin_Left();
    }
    else if (strcmp(command, "spinr") == 0) {
        Car_Spin_Right();
    }
    else if (strcmp(command, "stop") == 0) {
        Stop_All_Motors();
    }
    else if (strcmp(command, "gpio") == 0) {
        GPIO_Pin_Test();
    }
    else if (strcmp(command, "status") == 0) {
        Print_Test_Results();
    }
    else if (strcmp(command, "enable") == 0) {
        globalEnabled = true;
        printf("Motors ENABLED\r\n");
    }
    else if (strcmp(command, "disable") == 0) {
        Stop_All_Motors();
        globalEnabled = false;
        printf("Motors DISABLED\r\n");
    }
    else if (strcmp(command, "help") == 0) {
        Print_Menu();
    }
    else {
        printf("Unknown command: %s\r\n", command);
        printf("Type 'help' for command list\r\n");
    }
}

// 串口输入处理
void Handle_UART_Input(void)
{
    if (HAL_UART_Receive(&huart1, (uint8_t*)&uartBuffer[uartIndex], 1, 10) == HAL_OK) {
        if (uartBuffer[uartIndex] == '\r' || uartBuffer[uartIndex] == '\n') {
            uartBuffer[uartIndex] = '\0';
            if (uartIndex > 0) {
                printf("\r\nExecuting: %s\r\n", uartBuffer);
                Process_Command(uartBuffer);
                printf("\r\n> ");
            }
            uartIndex = 0;
        } else if (uartBuffer[uartIndex] == '\b' || uartBuffer[uartIndex] == 127) {
            if (uartIndex > 0) {
                uartIndex--;
                printf("\b \b");
            }
        } else {
            printf("%c", uartBuffer[uartIndex]);
            uartIndex++;
            if (uartIndex >= UART_BUFFER_SIZE - 1) {
                uartIndex = 0;
                printf("\r\nBuffer overflow! Resetting...\r\n> ");
            }
        }
    }
}

